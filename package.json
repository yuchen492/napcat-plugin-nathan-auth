{
  "name": "napcat-plugin-nathan-auth",
  "plugin": "授权管理助手",
  "version": "1.1.2",
  "type": "module",
  "main": "index.mjs",
  "description": "NapCat 授权管理助手插件 (支持WebUI管理面板/QQ指令/授权码发放/授权开通/到期监控/黑名单拉黑)",
  "author": "YunBai",
  "license": "MIT",
  "keywords": [
    "napcat",
    "plugin",
    "qq",
    "nathan",
    "auth",
    "license"
  ],
  "napcat": {
    "tags": [
      "授权管理",
      "站长工具",
      "WebUI"
    ],
    "minVersion": "4.14.0",
    "homepage": ""
  },
  "dependencies": {
    "napcat-types": "0.0.16"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "napcat-plugin-debug-cli": "^1.2.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "scripts": {
    "build": "vite build",
    "build:webui": "cd src/webui && npm install && npm run build",
    "dev:webui": "cd src/webui && npm run dev",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "deploy": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "icon": "icon.png"
}
